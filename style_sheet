body {
        margin: 0;
        overflow: hidden;
        background-color: #ffcdd2; /* 初期：赤（腫れ） */
        font-family: "Helvetica Neue", Arial, sans-serif;
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        height: 100vh;
        touch-action: none;
        user-select: none;
        -webkit-user-select: none;
    }
    h1 {
        font-size: 1.2rem;
        color: #b71c1c;
        margin-bottom: 10px;
        pointer-events: none;
        text-shadow: 1px 1px 2px rgba(255,255,255,0.5);
        position: absolute;
        top: 20px;
        width: 100%;
        text-align: center;
        z-index: 10;
    }
    #game-container {
        position: relative;
        width: 100%;
        height: 100%;
        display: flex;
        justify-content: center;
        align-items: center;
    }
    canvas {
        display: block;
        box-shadow: 0 10px 25px rgba(0,0,0,0.2);
        border-radius: 12px;
        background-color: rgba(255, 255, 255, 0.9);
        cursor: grab;
    }
    canvas:active {
        cursor: grabbing;
    }
    #status {
        position: absolute;
        bottom: 30px;
        width: 100%;
        font-weight: bold;
        color: #c62828;
        font-size: 1rem;
        text-align: center;
        pointer-events: none;
        z-index: 10;
        text-shadow: 0 1px 2px rgba(255,255,255,0.8);
    }
